{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Site": {
    "Name": "Know Your Agent",
    "RepositoryUri": "https://github.com/TheCodeTraveler/KnowYourAgentWebsite-Dotnet-Blazor"
  },
  "Checkpoint": {
    "OnAgentDetected": "Log",
    "SkipPaths": [
      "/_framework/",
      "/assets/",
      "/healthz",
      "/setup/status",
      "/favicon.ico"
    ]
  },
  "CheckpointPixel": {
    "Enabled": true,
    "ScriptUri": "https://kya.vouched.id/pixel.js",
    "Debug": false
  }
}
