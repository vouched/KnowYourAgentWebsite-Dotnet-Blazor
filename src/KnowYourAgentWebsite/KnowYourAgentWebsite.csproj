<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Declared here rather than in Directory.Build.props, because the kya-os CLI reads it from this file to detect the stack -->
    <TargetFramework>net10.0</TargetFramework>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <!--
      Your Vouched credentials are stored in the .NET user-secrets store on your machine, never in this repo.
      Run the app and paste them into step 1 on the home page, or use the dotnet user-secrets commands in README.md
    -->
    <UserSecretsId>eb760258-5806-4996-b846-6a747b5af07a</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="KyaOs.Checkpoint" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="KnowYourAgentWebsite.Tests" />
  </ItemGroup>

</Project>
