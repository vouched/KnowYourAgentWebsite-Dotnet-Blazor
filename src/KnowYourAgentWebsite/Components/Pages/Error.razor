@page "/error"
@using System.Diagnostics

<PageTitle>Something went wrong · Know Your Agent</PageTitle>

<section class="status-page" aria-labelledby="error-title">
	<div class="container status-page__inner">
		<p class="status-page__code">500</p>
		<h1 id="error-title">Something went wrong.</h1>
		<p class="lead">An unexpected error occurred while processing your request. Please try again in a moment.</p>
		@if (RequestId is not null)
		{
			<p class="status-page__request-id">Request ID <code>@RequestId</code></p>
		}
		<a class="btn btn--primary" href="/">
			Back to the sample
			<Icon Name="arrow-right" Size="18" />
		</a>
	</div>
</section>

@code {
	[CascadingParameter]
	HttpContext? HttpContext { get; set; }

	string? RequestId { get; set; }

	protected override void OnInitialized() =>
		RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
